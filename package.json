{
  "name": "tiktok-live-api",
  "version": "1.4.9",
  "description": "TikTok LIVE API for Node.js: real-time WebSocket chat, gifts, likes, viewers and battles, plus AI live captions and 60+ language translation. Managed signing, no sign server. Node and Python SDKs.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "tiktok",
    "tiktok-live",
    "tiktok-api",
    "tiktok-live-api",
    "tiktok-live-connector",
    "tiktok-live-sdk",
    "tiktok-live-node",
    "tiktok-live-js",
    "tiktok-live-python",
    "tiktok-websocket",
    "tiktok-chat",
    "tiktok-gifts",
    "tiktok-bot",
    "tiktok-events",
    "tiktok-data",
    "tiktok-stream",
    "tiktok-scraper",
    "tiktok-connector",
    "tiktok-monitoring",
    "tiktok-viewer",
    "tiktoklive",
    "tiktok-tools",
    "webcast",
    "websocket",
    "real-time",
    "live-streaming",
    "live-chat",
    "ai-captions",
    "live-captions",
    "captions",
    "transcription",
    "translation",
    "speech-to-text",
    "unreal-engine",
    "agency",
    "leaderboard",
    "euler-stream",
    "livestream-api"
  ],
  "author": {
    "name": "TikTool",
    "email": "support@tik.tools",
    "url": "https://tik.tools"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tiktool/tiktok-live-api.git"
  },
  "bugs": {
    "url": "https://github.com/tiktool/tiktok-live-api/issues"
  },
  "homepage": "https://tik.tools",
  "dependencies": {
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.10",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
